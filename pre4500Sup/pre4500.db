record(bo, "$(P)SIM")
{
    field(SCAN, "Passive")
    field(DTYP, "Soft Channel")
    field(ZNAM, "NO")
    field(ONAM, "YES")
    field(VAL, "$(RECSIM=0)")
    field(PINI, "YES")
}

record(bo, "$(P)DISABLE")
{
    field(DESC, "Disable comms")
    field(PINI, "YES")
    field(VAL, "$(DISABLE=0)")
    field(OMSL, "supervisory")
    field(ZNAM, "COMMS ENABLED")
    field(ONAM, "COMMS DISABLED")
}
record (ai, "$(P)CHAN4:TEMP") {

    field(DESC, "Chan 4 Temperature")
    $(IFNOTRECSIM) field(INP,  "@asyn($(PORT)MODBUS_RX_04,0)UINT16")
    $(IFNOTRECSIM) field(SCAN, "I/O Intr")
    $(IFNOTRECSIM) field(DTYP, "asynInt32")

    field(EGU,  "C")
    field(PREC, "3")

    info(INTEREST, "HIGH")
    # info(ARCHIVE,  "10 VAL")

    field(SDIS, "$(P)DISABLE")
    field(SSCN, "Passive")
    field(SIML, "$(P)SIM")
    field(SIOL, "$(P)SIM:CHAN4:TEMP CP")
    field(ASLO, "0.1") 
}

record(stringin, "$(P)CHAN4:NAME") {
    field(VAL, "$(CHAN4_NAME)")
	field(PINI, "YES")
}

